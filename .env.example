# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# .env is git-ignored: never commit a real key.

# Required: the OpenAI API key the shop assistant (Professor Dan) uses.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: which OpenAI model answers chats (default: gpt-5.6-terra).
# CHAT_MODEL=gpt-5.6-terra

# Optional: the key that signs login cookies. If unset, a random one is created
# in backend/.session_secret (also git-ignored) the first time the server starts.
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: set to 1 when the site is served over https (marks the login cookie Secure).
# HTTPS_ONLY=1
